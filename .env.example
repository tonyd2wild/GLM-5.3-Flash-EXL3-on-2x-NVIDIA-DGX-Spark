# GLM-5.3-Flash EXL3 2x DGX Spark — copy to .env and edit for YOUR fabric.
# No credentials live here (all infra config). Do NOT commit your real .env.

# --- nodes ---
HEAD_IP=192.168.192.1                 # Bluey (this box, serves the API)
WORKER_IP=192.168.192.3               # Asusi
WORKER_SSH=tonyspark3@192.168.192.3   # passwordless SSH from head -> worker
WORKER_USER=tonyspark3
WORKER_HOME=/home/tonyspark3

# --- RoCE fabric (VERIFY per node: state ACTIVE + gid index carrying your fabric IP) ---
# Our Sparks: f1 is DOWN, f0 is the live CX7 port on every node -> symmetric f0/gid3.
HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f0
NCCL_IB_HCA=rocep1s0f0
# NCCL_IB_GID_INDEX=3  (set in the launcher; index 3 = RoCEv2 ::ffff:<fabric ip>)

# --- model ---
MODEL=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=1ae6d70430a12d762917786696db06a7b4f9bbae
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3
PORT=8000

# --- image (build locally for matching sm_121a cubins) ---
IMAGE=glm53-flash-sm121:local
SKIP_PULL=1

# --- serving / KV (do not deviate: fp8 KV, no marlin) ---
MAX_MODEL_LEN=1000000
MAX_NUM_BATCHED_TOKENS=3584
MAX_NUM_SEQS=4
LONG_PREFILL_TOKEN_THRESHOLD=1792
GLM53_FINE_GRAINED_APC=1
KV_CACHE_DTYPE=fp8
GPU_MEM_UTIL=0.85                     # boot gate under the KV pin; 0.87 crash-loops
EXTRA_ARGS="--kv-cache-memory-bytes 15414698763 --no-async-scheduling"
VLLM_PREFIX_CACHE_RETENTION_INTERVAL_SWA=0

# --- speculative drafter ---
SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=7d74cdd881ed7e32c31175984a67823127b66cfe
DFLASH_TOKENS=7

# --- timeouts (cold JIT after a cache wipe is slow, not dead) ---
READY_TIMEOUT=4800
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800

# --- optional: uncensored variant ---
# ABLIT=1
